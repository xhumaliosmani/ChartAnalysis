# Template only — do not fill real secrets here.
# On Streamlit Community Cloud, paste these into:
#   App dashboard → ⋯ → Settings → Secrets
# Streamlit exposes entries as both st.secrets["KEY"] and env vars.
#
# For LOCAL runs, use .env instead (see .env.example).

ANTHROPIC_API_KEY = "sk-ant-replace-me"
APP_PASSWORD      = "choose-a-long-passphrase"
DATABASE_URL      = "postgresql://user:pass@host:5432/dbname?sslmode=require"
